prefix=/usr/local
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: uart_app
Description: Build requirements for the uart_app host tool (video -> 7-seg over UART)
Version: 1.0.0
Requires: opencv5 sdl2 libavformat libavcodec libavutil libswresample
Cflags: -I${includedir}/uart_app
